\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Quick look at the sign-sweep comparison between the \textit  {C.\ elegans} and \textit  {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit  {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology.}}{18}{figure.9}\protected@file@percent }
\newlabel{fig:sign_sweep_quicklook}{{9}{18}{Quick look at the sign-sweep comparison between the \textit {C.\ elegans} and \textit {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Sign-balance normalization ablation for the \textit  {C.\ elegans}-matched ER topology. Scaling by the original spectral radius weakens the performance increase associated with changing the negative edge fraction.}}{18}{figure.10}\protected@file@percent }
\newlabel{fig:sign_norm_matched_er}{{10}{18}{Sign-balance normalization ablation for the \textit {C.\ elegans}-matched ER topology. Scaling by the original spectral radius weakens the performance increase associated with changing the negative edge fraction}{figure.10}{}}

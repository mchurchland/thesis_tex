\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Relationship between raw spectral radius and reservoir behavior across sign-sweep and shuffle-control families under spectral-radius normalization. The top row shows mean task-agnostic performance as a function of raw spectral radius before normalization, \(\rho _{\mathrm  {raw}}\), on a log scale. The bottom row shows the corresponding hyperparameter CV. Columns correspond to GR, truncated IPC, KR, and MC. Lines connect points within experimental families.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:raw_rho_summary}{{5}{8}{Relationship between raw spectral radius and reservoir behavior across sign-sweep and shuffle-control families under spectral-radius normalization. The top row shows mean task-agnostic performance as a function of raw spectral radius before normalization, \(\rho _{\mathrm {raw}}\), on a log scale. The bottom row shows the corresponding hyperparameter CV. Columns correspond to GR, truncated IPC, KR, and MC. Lines connect points within experimental families}{figure.5}{}}

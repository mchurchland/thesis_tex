\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Mean performance and mean hyperparameter CV as a function of negative sign percentage for the \textit  {C.\ elegans}-matched ER topology. IPC is denoted in orange, GR in red, MC in blue, and KR in green. The same performance--invariance tradeoff appears without the biological topology, indicating that global sign balance can act as a primary control parameter within this matched random-topology setting. A total of 50 trials were performed for each fraction.}}{13}{figure.7}\protected@file@percent }
\newlabel{fig:er_frac_curves}{{7}{13}{Mean performance and mean hyperparameter CV as a function of negative sign percentage for the \textit {C.\ elegans}-matched ER topology. IPC is denoted in orange, GR in red, MC in blue, and KR in green. The same performance--invariance tradeoff appears without the biological topology, indicating that global sign balance can act as a primary control parameter within this matched random-topology setting. A total of 50 trials were performed for each fraction}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Mean performance and mean hyperparameter CV as a function of negative sign percentage for the empirical \textit  {C.\ elegans} magnitude pattern after removing connections with unknown or complex signs. IPC is denoted in orange, GR in red, MC in blue, and KR in green. Reintroducing inhibitory signs again traces the performance--invariance tradeoff, now with empirical magnitudes held in place. A total of 50 trials were performed for each fraction.}}{13}{figure.8}\protected@file@percent }
\newlabel{fig:og_cel_frac_curves}{{8}{13}{Mean performance and mean hyperparameter CV as a function of negative sign percentage for the empirical \textit {C.\ elegans} magnitude pattern after removing connections with unknown or complex signs. IPC is denoted in orange, GR in red, MC in blue, and KR in green. Reintroducing inhibitory signs again traces the performance--invariance tradeoff, now with empirical magnitudes held in place. A total of 50 trials were performed for each fraction}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Quick look at the sign-sweep comparison between the \textit  {C.\ elegans} and \textit  {C.\ elegans}-matched ER topologies. The vertical dashed line marks the empirical negative-edge fraction. In the \textit  {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:sign_sweep_quicklook}{{9}{13}{Quick look at the sign-sweep comparison between the \textit {C.\ elegans} and \textit {C.\ elegans}-matched ER topologies. The vertical dashed line marks the empirical negative-edge fraction. In the \textit {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology}{figure.9}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Quick look at the sign-sweep comparison between the \textit  {C.\ elegans} and \textit  {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit  {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology. Each point represents the mean across 100 trials.}}{14}{figure.9}\protected@file@percent }
\newlabel{fig:sign_sweep_quicklook}{{9}{14}{Quick look at the sign-sweep comparison between the \textit {C.\ elegans} and \textit {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology. Each point represents the mean across 100 trials}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Reservoir activity under all-positive (0\% negative edges) and sign-balanced (50\% negative edges) versions of the ambiguous-edge \textit  {C.\ elegans} network. The topology and contact-count magnitudes are held fixed while edge signs are reassigned. Panel A shows the total number of neuron--time samples for which the absolute reservoir state satisfies \( |x_i|\geq 0.5 \) during 1,000 post-washout time steps. Panel B shows the total number of transitions from \( |x_i|<0.5 \) to \( |x_i|\geq 0.5 \). Each dot is the mean across 50 repeats at one target spectral radius, \(\rho _{\mathrm  {target}}\in \{0.60,0.80,0.95,1.05\}\); bars show the mean of these four target-level means. The displayed raw spectral radii are means calculated before normalization.}}{15}{figure.10}\protected@file@percent }
\newlabel{fig:activity_0_vs_50}{{10}{15}{Reservoir activity under all-positive (0\% negative edges) and sign-balanced (50\% negative edges) versions of the ambiguous-edge \textit {C.\ elegans} network. The topology and contact-count magnitudes are held fixed while edge signs are reassigned. Panel A shows the total number of neuron--time samples for which the absolute reservoir state satisfies \( |x_i|\geq 0.5 \) during 1,000 post-washout time steps. Panel B shows the total number of transitions from \( |x_i|<0.5 \) to \( |x_i|\geq 0.5 \). Each dot is the mean across 50 repeats at one target spectral radius, \(\rho _{\mathrm {target}}\in \{0.60,0.80,0.95,1.05\}\); bars show the mean of these four target-level means. The displayed raw spectral radii are means calculated before normalization}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Mean absolute recurrent weight within closed three-neuron subgraphs across the negative-edge fraction sweep. A closed triad is defined here as a set of three neurons for which every unordered neuron pair is connected by at least one directed edge; each triad can therefore contain three to six directed edges. For each of the 6,527 closed triads, we calculate the mean absolute weight over its present directed edges after scaling the complete reservoir to the target spectral radius. Points show the mean of this triad-level statistic across 50 repeats, and error bars show the standard deviation across repeat-level means. Panels correspond to target spectral radii \(\rho _{\mathrm  {target}}=0.60\), \(0.80\), \(0.95\), and \(1.05\). Because topology and unnormalized weight magnitudes are held fixed, the variation across negative-edge fractions reflects changes in the global scaling required to reach each target spectral radius.}}{15}{figure.11}\protected@file@percent }
\newlabel{fig:triad_sign_fraction}{{11}{15}{Mean absolute recurrent weight within closed three-neuron subgraphs across the negative-edge fraction sweep. A closed triad is defined here as a set of three neurons for which every unordered neuron pair is connected by at least one directed edge; each triad can therefore contain three to six directed edges. For each of the 6,527 closed triads, we calculate the mean absolute weight over its present directed edges after scaling the complete reservoir to the target spectral radius. Points show the mean of this triad-level statistic across 50 repeats, and error bars show the standard deviation across repeat-level means. Panels correspond to target spectral radii \(\rho _{\mathrm {target}}=0.60\), \(0.80\), \(0.95\), and \(1.05\). Because topology and unnormalized weight magnitudes are held fixed, the variation across negative-edge fractions reflects changes in the global scaling required to reach each target spectral radius}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Sign-balance normalization ablation for the \textit  {C.\ elegans}-matched ER topology. Scaling by the original spectral radius weakens the performance increase associated with changing the negative edge fraction. Each point represents the mean across 100 trials.}}{16}{figure.12}\protected@file@percent }
\newlabel{fig:sign_norm_matched_er}{{12}{16}{Sign-balance normalization ablation for the \textit {C.\ elegans}-matched ER topology. Scaling by the original spectral radius weakens the performance increase associated with changing the negative edge fraction. Each point represents the mean across 100 trials}{figure.12}{}}

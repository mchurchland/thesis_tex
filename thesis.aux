\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Quick look at the sign-sweep comparison between the \textit  {C.\ elegans} and \textit  {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit  {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology.}}{20}{figure.9}\protected@file@percent }
\newlabel{fig:sign_sweep_quicklook}{{9}{20}{Quick look at the sign-sweep comparison between the \textit {C.\ elegans} and \textit {C.\ elegans}-matched ER topologies. The vertical dashed line marks the EleganSign-inferred negative-edge fraction. In the \textit {C.\ elegans} sweep, the raw spectral radius can dip below the original baseline slightly before that fraction is reached because sign placement is simultaneously being randomized. The ER-matched sweep shows a smaller offset, consistent with signs already being effectively random relative to topology}{figure.9}{}}

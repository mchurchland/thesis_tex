\citation{fenyves_szilágyi_zsolt_vassy_csaba_2020}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Relationship between raw spectral radius and reservoir behavior across E/I edge balance sweep and shuffle-control families under spectral-radius normalization. Rows correspond to truncated IPC, KR, and MC. The left column shows mean task-agnostic performance as a function of raw spectral radius before normalization, \(\rho _{\mathrm  {raw}}\), on a log scale; the right column shows the corresponding hyperparameter CV. Lines connect points within each experimental family. The binary, PM1, and \textit  {C.\ elegans} shuffle-controls are from Figure~\ref {fig:shuf_all}; the \textit  {C.\ elegans} E/I sweep, restricted to conditions with less than \(50\%\) negative edges, is from Figure~\ref {fig:ambig_cel_frac_curves}.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:raw_rho_summary}{{5}{9}{Relationship between raw spectral radius and reservoir behavior across E/I edge balance sweep and shuffle-control families under spectral-radius normalization. Rows correspond to truncated IPC, KR, and MC. The left column shows mean task-agnostic performance as a function of raw spectral radius before normalization, \(\rho _{\mathrm {raw}}\), on a log scale; the right column shows the corresponding hyperparameter CV. Lines connect points within each experimental family. The binary, PM1, and \textit {C.\ elegans} shuffle-controls are from Figure~\ref {fig:shuf_all}; the \textit {C.\ elegans} E/I sweep, restricted to conditions with less than \(50\%\) negative edges, is from Figure~\ref {fig:ambig_cel_frac_curves}}{figure.5}{}}
